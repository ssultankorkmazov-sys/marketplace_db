{
  "name": "marketkz-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/package-replenishment-report.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "node --require ./scripts/node-os-userinfo-fallback.cjs --import tsx/esm scripts/migrate.ts",
    "db:migrate:copy": "node --require ./scripts/node-os-userinfo-fallback.cjs --import tsx/esm scripts/migrate-copy.ts",
    "db:migrate:main": "node --require ./scripts/node-os-userinfo-fallback.cjs --import tsx/esm scripts/migrate-main.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/anomalies.integration.test.ts tests/jeffreys-shadow.integration.test.ts tests/replenishment-history.integration.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
